# Secrets des Edge Functions — copier vers supabase/functions/.env
# puis : supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY sont injectés automatiquement par Supabase)

# URL publique du frontend (sans slash final)
APP_URL=https://<ton-site>.netlify.app

# Secret partagé avec le job pg_cron (même valeur que le secret Vault "cron_secret")
CRON_SECRET=

# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google (YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X / Twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
